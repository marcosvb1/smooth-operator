{
  "meta": {
    "name": "cadence-followup",
    "pattern": "message -> wait(timer|reply) -> reminder -> wait -> branch (status / tag)",
    "description": "Cadência de follow-up: espera resposta por um tempo; se não responder, manda lembrete e espera de novo; ramifica entre 'sem resposta' (muda status) e 'respondeu' (marca campo).",
    "source_bot": "cadence-followup.source.json",
    "channels": [
      "whatsapp"
    ]
  },
  "slots": [
    {
      "name": "bot_name",
      "kind": "text",
      "required": true,
      "hint": "nome do bot"
    },
    {
      "name": "reminder_text",
      "kind": "text",
      "required": true,
      "hint": "texto do lembrete enviado se o lead não responder no 1º prazo"
    },
    {
      "name": "chat_source_1",
      "kind": "chat_source",
      "required": true,
      "sentinel": -901,
      "hint": "canal verificado #1"
    },
    {
      "name": "chat_source_2",
      "kind": "chat_source",
      "required": true,
      "sentinel": -902,
      "hint": "canal verificado #2; use o mesmo id de #1 se só houver 1 canal"
    },
    {
      "name": "delay_reattempt_s",
      "kind": "delay",
      "required": true,
      "sentinel": -911,
      "hint": "segundos antes do lembrete (ex.: 7200 = 2h)"
    },
    {
      "name": "delay_followup_s",
      "kind": "delay",
      "required": true,
      "sentinel": -912,
      "hint": "segundos de espera após o lembrete (ex.: 86400 = 24h)"
    },
    {
      "name": "status_noreply_id",
      "kind": "status",
      "required": true,
      "sentinel": -903,
      "hint": "status_id pra mover quem não respondeu (RESOLVER no inventário)"
    },
    {
      "name": "status_noreply_pipeline",
      "kind": "pipeline",
      "required": true,
      "sentinel": -904,
      "hint": "pipeline_id do status acima"
    },
    {
      "name": "cf_noreply_field",
      "kind": "raw",
      "required": false,
      "hint": "placeholder do campo marcado em 'sem resposta' (ex.: {{lead.cf.<FIELD_ID>}})"
    },
    {
      "name": "cf_noreply_value",
      "kind": "raw",
      "required": false,
      "hint": "valor gravado no campo (ex.: {{lead.cf.<FIELD_ID>.<ENUM_ID>}})"
    },
    {
      "name": "cf_replied_field",
      "kind": "raw",
      "required": false,
      "hint": "placeholder do campo marcado em 'respondeu' (ex.: {{lead.cf.<FIELD_ID>}})"
    },
    {
      "name": "cf_replied_value",
      "kind": "raw",
      "required": false,
      "hint": "valor gravado no campo (ex.: {{lead.cf.<FIELD_ID>.<ENUM_ID>}})"
    }
  ],
